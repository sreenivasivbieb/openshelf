# Copy to .env (repo root) and fill in. Never commit real values.
# Only bootstrap/env.ts reads these; everything else receives config as parameters.

# --- Server ---
NODE_ENV=development
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787        # used in MCP URLs, PayPal return URLs, OpenAPI servers[]
LOG_LEVEL=info
DATABASE_PATH=./storage/openshelf.db
QUOTE_TTL_MINUTES=15
ADMIN_TOKEN=change-me-to-a-long-random-string # protects /admin/* (onboarding + dashboard API)
DASHBOARD_ORIGIN=http://localhost:5173       # CORS allow-list for the Vite dev server

# --- PayPal (sandbox only, by design) ---
# One platform app from developer.paypal.com. Merchants are paid as `payee`, so no merchant secret is stored.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Spec Agent (onboarding only; never called on /quote or /order) ---
# Leave empty to run rules-only firewall + template spec (demo-safe fallback).
# With a key, each catalog commit makes about 2 calls per 20 products (firewall + rewrite) plus 1 for the
# spec, and each preview with unmapped headers makes 1. Details: docs/architecture/spec-agent.md
ANTHROPIC_API_KEY=
SPEC_AGENT_MODEL=claude-opus-5-5
